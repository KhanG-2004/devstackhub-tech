---
import { Terminal, Send, X, Bot, Sparkles } from 'lucide-astro';
---

<!-- Floating Launcher Button -->
<div id="ai-chat-container" class="fixed bottom-6 right-6 z-[90] font-sans">
  
  <button 
    id="chat-toggle-btn"
    type="button"
    class="relative group px-4 py-2.5 rounded-full bg-white dark:bg-[#070D18] border border-slate-200 dark:border-emerald-500/40 text-emerald-600 dark:text-emerald-400 hover:border-emerald-500/50 hover:shadow-[0_0_25px_rgba(16,185,129,0.25)] shadow-lg flex items-center gap-2.5 transition-all duration-300 active:scale-95 cursor-pointer"
    aria-label="Open DevStack Assistant"
  >
    <div class="relative flex items-center justify-center">
      <Bot class="w-4 h-4 text-emerald-600 dark:text-emerald-400 group-hover:rotate-12 transition-transform duration-300" />
      <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-ping"></span>
    </div>
    <span class="text-xs font-mono font-bold tracking-wider text-slate-800 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-300 transition-colors">
      DevStack AI
    </span>
    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400">
      v1.0
    </span>
  </button>

  <!-- Interactive Terminal Window -->
  <div 
    id="chat-window" 
    class="hidden absolute bottom-16 right-0 w-[92vw] sm:w-[400px] h-[520px] max-h-[80vh] rounded-2xl bg-white dark:bg-[#090E1A] border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex-col transition-all duration-200"
  >
    <!-- Terminal Header Bar -->
    <div class="h-12 bg-slate-100 dark:bg-[#060A12] px-4 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 shrink-0">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
        </div>
        <span class="text-xs font-mono text-slate-700 dark:text-slate-300 font-bold ml-1.5 flex items-center gap-1.5">
          <Terminal class="w-3.5 h-3.5 text-emerald-500" /> devstack-assistant.sh
        </span>
      </div>

      <button 
        id="chat-close-btn" 
        type="button"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close Assistant"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Messages Output Stream -->
    <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3.5 text-xs font-mono leading-relaxed bg-slate-50/50 dark:bg-[#040810]/50">
      <div class="flex items-start gap-2.5 text-slate-700 dark:text-slate-300">
        <div class="w-6 h-6 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 flex items-center justify-center shrink-0 mt-0.5">
          <Sparkles class="w-3.5 h-3.5" />
        </div>
        <div class="bg-white dark:bg-[#090E1A] border border-slate-200 dark:border-slate-800/80 rounded-xl p-3 shadow-sm">
          Welcome to the DevStackHub terminal. Ask for architectural recommendations, Docker/K8s commands, or Azure configs.
        </div>
      </div>
    </div>

    <!-- Terminal Input Form -->
    <form id="chat-form" class="p-3 bg-white dark:bg-[#090E1A] border-t border-slate-200 dark:border-slate-800 flex items-center gap-2 shrink-0">
      <input 
        id="chat-input"
        type="text" 
        required
        autocomplete="off"
        placeholder="e.g. How to set up Azure AKS Ingress?"
        class="flex-1 px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
      />
      <button 
        type="submit" 
        id="chat-send-btn"
        class="p-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold flex items-center justify-center transition-all disabled:opacity-50 cursor-pointer shrink-0"
        aria-label="Send message"
      >
        <Send class="w-4 h-4" />
      </button>
    </form>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('chat-toggle-btn');
    const closeBtn = document.getElementById('chat-close-btn');
    const chatWindow = document.getElementById('chat-window');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const messagesBox = document.getElementById('chat-messages');
    const sendBtn = document.getElementById('chat-send-btn');

    // Restore chat history from sessionStorage if available
    const savedHistory = sessionStorage.getItem('devstack_chat_history');
    if (savedHistory && messagesBox) {
      messagesBox.innerHTML = savedHistory;
      messagesBox.scrollTop = messagesBox.scrollHeight;
    }

    function saveHistory() {
      if (messagesBox) {
        sessionStorage.setItem('devstack_chat_history', messagesBox.innerHTML);
      }
    }

    function toggleChat() {
      if (!chatWindow) return;
      const isHidden = chatWindow.classList.contains('hidden');
      if (isHidden) {
        chatWindow.classList.remove('hidden');
        chatWindow.classList.add('flex');
        chatInput && chatInput.focus();
      } else {
        chatWindow.classList.add('hidden');
        chatWindow.classList.remove('flex');
      }
    }

    toggleBtn && toggleBtn.addEventListener('click', toggleChat);
    closeBtn && closeBtn.addEventListener('click', toggleChat);

    chatForm && chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = chatInput.value.trim();
      if (!query || !messagesBox) return;

      appendMessage(query, 'user');
      chatInput.value = '';
      if (sendBtn) sendBtn.disabled = true;

      const loaderId = appendLoading();
      messagesBox.scrollTop = messagesBox.scrollHeight;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: query }),
        });

        const data = await res.json();
        removeLoading(loaderId);

        if (data && data.response) {
          appendMessage(data.response, 'bot');
        } else {
          appendMessage('Error: Model returned no response. Check edge binding.', 'bot');
        }
      } catch (err) {
        removeLoading(loaderId);
        appendMessage('Connection error: Failed to reach edge server.', 'bot');
      } finally {
        if (sendBtn) sendBtn.disabled = false;
        messagesBox.scrollTop = messagesBox.scrollHeight;
        saveHistory();
      }
    });

    function appendMessage(text, sender) {
      if (!messagesBox) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = sender === 'user' 
        ? 'flex justify-end text-xs font-mono text-slate-100' 
        : 'flex items-start gap-2.5 text-xs font-mono text-slate-700 dark:text-slate-300';

      if (sender === 'user') {
        msgDiv.innerHTML = `
          <div class="bg-emerald-600 dark:bg-emerald-600/90 text-white rounded-xl p-3 max-w-[85%] shadow-sm">
            ${escapeHtml(text)}
          </div>
        `;
      } else {
        msgDiv.innerHTML = `
          <div class="w-6 h-6 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </div>
          <div class="bg-white dark:bg-[#090E1A] border border-slate-200 dark:border-slate-800/80 rounded-xl p-3 shadow-sm max-w-[88%] whitespace-pre-wrap leading-relaxed">
            ${formatBotOutput(text)}
          </div>
        `;
      }
      messagesBox.appendChild(msgDiv);
      messagesBox.scrollTop = messagesBox.scrollHeight;
      saveHistory();
    }

    function appendLoading() {
      const id = 'loading-' + Date.now();
      const loader = document.createElement('div');
      loader.id = id;
      loader.className = 'flex items-center gap-2 text-xs font-mono text-emerald-500 animate-pulse';
      loader.innerHTML = `<span>•</span><span>•</span><span>•</span> <span class="text-slate-500">Querying edge model...</span>`;
      messagesBox && messagesBox.appendChild(loader);
      return id;
    }

    function removeLoading(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function formatBotOutput(str) {
      let formatted = str
        .replace(/^(bash|sh|json|yaml|yml|dockerfile)\b/gm, '')
        .trim();

      let html = escapeHtml(formatted)
        .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
        .replace(/\`\`\`([\s\S]*?)\`\`\`/g, '<pre class="my-2 p-2.5 rounded-lg bg-slate-900 text-emerald-400 overflow-x-auto text-[11px]"><code>$1</code></pre>')
        .replace(/\`([^`]+)\`/g, '<code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400">$1</code>')
        // Force markdown links to open in a new tab securely
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-emerald-500 underline hover:text-emerald-400 font-semibold" target="_blank" rel="noopener noreferrer">$1</a>');

      // Force auto-detected raw paths to open in a new tab securely
      html = html.replace(/(\/[a-z0-9\-_]+\/)/g, '<a href="$1" class="text-emerald-500 font-semibold underline hover:text-emerald-400" target="_blank" rel="noopener noreferrer">$1</a>');

      return html;
    }
  });
</script>