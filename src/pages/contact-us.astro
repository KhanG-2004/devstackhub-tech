---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { ArrowLeft, Mail, MessageSquare, Handshake, Clock, Globe, Copy, Check, Send, Sparkles } from 'lucide-astro';
---

<BaseLayout 
  title="Contact Us — DevStackHub" 
  description="Have a question, feedback on an article, or an inquiry regarding technical collaboration? Get in touch with the DevStackHub team."
>
  <Header />

  <!-- Ambient Glow -->
  <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[400px] bg-gradient-to-b from-emerald-500/15 via-teal-500/5 to-transparent blur-[140px] rounded-full dark:opacity-100 opacity-40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.04] dark:opacity-[0.06]"></div>
  </div>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-28 relative z-10">
    <!-- Back to Hub -->
    <a href="/" class="inline-flex items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 transition-colors mb-8 group">
      <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" /> Return to Architecture Hub
    </a>

    <!-- Page Header -->
    <header class="pb-10 border-b border-slate-200 dark:border-slate-800/80 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 mb-4">
        <Mail class="w-3.5 h-3.5" />
        <span>DIRECT CHANNELS</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Contact Us
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
        Have a question, feedback on an article, or an inquiry regarding technical collaboration? Reach out through direct channels or transmit a secure message below.
      </p>
    </header>

    <!-- Balanced 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Direct Communication Channels & Telemetry -->
      <div class="lg:col-span-5 space-y-5">
        
        <!-- Channel 1: General Inquiries with One-Click Copy -->
        <div class="p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all">
          <div class="flex items-center gap-2.5 mb-2.5">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <MessageSquare class="w-4 h-4" />
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">General Inquiries & Feedback</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            For editorial suggestions, corrections, or technical queries about our published playbooks.
          </p>
          <div class="mt-4 pt-3.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:border-emerald-500/50 transition-all cursor-pointer"
              data-copy="contact@devstackhub.tech"
            >
              <span class="copy-label font-medium">contact@devstackhub.tech</span>
              <Copy class="w-3.5 h-3.5 copy-icon shrink-0" />
              <Check class="w-3.5 h-3.5 check-icon text-emerald-500 hidden shrink-0" />
            </button>
            <span class="text-[11px] font-mono text-slate-500">Copy</span>
          </div>
        </div>

        <!-- Channel 2: Technical Collaborations -->
        <div class="p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all">
          <div class="flex items-center gap-2.5 mb-2.5">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <Handshake class="w-4 h-4" />
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Collaborations & Partnerships</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Interested in guest authoring, sponsored architectures, or technical consultations.
          </p>
          <div class="mt-4 pt-3.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:border-emerald-500/50 transition-all cursor-pointer"
              data-copy="support@devstackhub.tech"
            >
              <span class="copy-label font-medium">support@devstackhub.tech</span>
              <Copy class="w-3.5 h-3.5 copy-icon shrink-0" />
              <Check class="w-3.5 h-3.5 check-icon text-emerald-500 hidden shrink-0" />
            </button>
            <a href="/write-for-us/" class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 hover:underline">Write for Us →</a>
          </div>
        </div>

        <!-- Response Time SLA -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 shadow-sm dark:shadow-none">
          <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            <Clock class="w-4 h-4" />
            <span>Response Telemetry</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            We review transmissions and respond within <strong class="text-slate-900 dark:text-white">24 to 48 business hours</strong>.
          </p>
        </div>

        <!-- Location & Operations Card -->
        <div class="p-5 rounded-2xl bg-slate-100/80 dark:bg-[#070D18] border border-slate-200 dark:border-emerald-500/20 shadow-sm dark:shadow-none">
          <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-slate-800 dark:text-emerald-400">
            <Globe class="w-4 h-4" />
            <span>Distributed Edge Operations</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            DevStackHub operates digitally across distributed timezones, providing global engineers with battle-tested cloud blueprints.
          </p>
        </div>

      </div>

      <!-- Right Column: Interactive Terminal Transmission Form -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl bg-white dark:bg-[#090E1A] border border-slate-200 dark:border-slate-800 shadow-xl dark:shadow-2xl overflow-hidden">
          
          <!-- Terminal Window Header -->
          <div class="h-11 bg-slate-100 dark:bg-[#060A12] px-5 flex items-center justify-between border-b border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <Sparkles class="w-3.5 h-3.5 text-emerald-500" /> send-transmission.sh
            </span>
            <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-bold">READY</span>
          </div>

          <!-- Form Body -->
          <form id="contact-form" class="p-6 sm:p-8 space-y-5" onsubmit="event.preventDefault(); handleFormSubmit();">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-mono font-semibold uppercase text-slate-700 dark:text-slate-300 mb-1.5">
                  Your Name <span class="text-emerald-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Linus Torvalds"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono font-semibold uppercase text-slate-700 dark:text-slate-300 mb-1.5">
                  Work Email <span class="text-emerald-500">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="architect@domain.com"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="inquiry-type" class="block text-xs font-mono font-semibold uppercase text-slate-700 dark:text-slate-300 mb-1.5">
                Inquiry Focus <span class="text-emerald-500">*</span>
              </label>
              <select 
                id="inquiry-type" 
                name="inquiry-type"
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-900 dark:text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors"
              >
                <option value="feedback">Article Feedback / Code Correction</option>
                <option value="guest-post">Technical Writing & Guest Posting</option>
                <option value="collaboration">Infrastructure & Architecture Consultation</option>
                <option value="other">General Inquiries</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-mono font-semibold uppercase text-slate-700 dark:text-slate-300 mb-1.5">
                Transmission Context <span class="text-emerald-500">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                placeholder="Include relevant framework versions, article references, or architectural context..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-emerald-500 transition-colors resize-y"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
              <span class="text-[11px] font-mono text-slate-500 dark:text-slate-500">
                End-to-end TLS protected message transmission.
              </span>

              <button 
                type="submit" 
                id="submit-btn"
                class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold font-mono text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(16,185,129,0.35)] transition-all shrink-0 active:scale-95 cursor-pointer"
              >
                <span id="submit-text">Send Transmission</span>
                <Send class="w-3.5 h-3.5" />
              </button>
            </div>
          </form>

          <!-- Success Alert Message (Hidden Initially) -->
          <div id="form-success" class="hidden p-6 sm:p-8 text-center space-y-3 bg-emerald-500/10 border-t border-emerald-500/20">
            <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center mx-auto">
              <Check class="w-5 h-5" />
            </div>
            <h4 class="text-base font-bold text-slate-900 dark:text-white">Transmission Dispatched</h4>
            <p class="text-xs font-mono text-slate-600 dark:text-slate-400 max-w-sm mx-auto leading-relaxed">
              Your inquiry has been queued. Our lead engineers review incoming feeds and will follow up within 24 to 48 hours.
            </p>
          </div>

        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  // Copy to Clipboard buttons
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy');
      const label = btn.querySelector<HTMLElement>('.copy-label');
      const copyIcon = btn.querySelector<HTMLElement>('.copy-icon');
      const checkIcon = btn.querySelector<HTMLElement>('.check-icon');

      if (email && label) {
        try {
          await navigator.clipboard.writeText(email);
          const originalText = label.textContent;
          label.textContent = 'Copied to clipboard!';
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');

          setTimeout(() => {
            label.textContent = originalText;
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      }
    });
  });

  // Client-side form simulation / handler
  function handleFormSubmit() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successBox = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text');

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = 'Transmitting...';
    }

    setTimeout(() => {
      if (form && successBox) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      }
    }, 800);
  }

  // Bind to global window for inline onsubmit attribute
  (window as any).handleFormSubmit = handleFormSubmit;
</script>