---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { 
  ArrowUpRight, 
  Sparkles, 
  Terminal as TerminalIcon, 
  Clock, 
  ChevronRight, 
  Cloud, 
  Server, 
  Code2, 
  BookOpen,
  Radio,
  Mail,
  Send
} from 'lucide-astro';

const allPosts = await getCollection('blog');
// Strict 1-to-9 ordering
const posts = allPosts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const getCategoryKey = (cat: string) => {
  if (cat.includes('DevOps') || cat.includes('Cloud')) return 'devops';
  if (cat.includes('System') || cat.includes('Admin')) return 'sysadmin';
  if (cat.includes('Web')) return 'webdev';
  if (cat.includes('Guide')) return 'guides';
  return 'all';
};

const countCategory = (key: string) => {
  return posts.filter(p => getCategoryKey(p.data.category) === key).length;
};

const getImageUrl = (img?: string) => {
  if (!img) return null;
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  return `https://devstackhub.tech${img.startsWith('/') ? img : '/' + img}`;
};
---

<BaseLayout title="DevStackHub — Cloud Architecture & High-Performance Engineering">
  <Header />

  <!-- Ambient Glow & Matrix Grid Background -->
  <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
    <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-emerald-500/15 via-teal-500/5 to-transparent blur-[140px] rounded-full dark:opacity-100 opacity-40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.04] dark:opacity-[0.07]"></div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-24">
    
    <!-- Hero Split Layout -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.15)] mb-6">
          <Sparkles class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
          <span>PRODUCTION-GRADE ARCHITECTURE PLAYBOOKS</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.08]">
          Engineering Hub for Modern <span class="bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent">Cloud Architects</span>
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">
          DevStackHub delivers battle-tested infrastructure blueprints, Linux kernel hardening playbooks, and high-performance Jamstack engineering tutorials.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#guides" class="relative group px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-bold text-sm shadow-[0_0_25px_rgba(16,185,129,0.35)] hover:shadow-[0_0_35px_rgba(16,185,129,0.55)] transition-all flex items-center gap-2 overflow-hidden">
            <span class="relative z-10 flex items-center gap-2">Explore Blueprints <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></span>
            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
          </a>

          <a href="/write-for-us/" class="px-5 py-3 rounded-xl bg-white dark:bg-slate-900/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700/80 hover:border-emerald-500/40 text-sm font-semibold transition-all flex items-center gap-2 shadow-sm">
            Submit Article <ChevronRight class="w-4 h-4 text-emerald-500 dark:text-emerald-400" />
          </a>
        </div>

        <div class="mt-12 grid grid-cols-3 gap-6 pt-8 border-t border-slate-200 dark:border-slate-800/80 w-full max-w-lg">
          <div>
            <span class="block text-2xl font-black text-slate-900 dark:text-white font-mono">100<span class="text-emerald-500 dark:text-emerald-400">%</span></span>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">Edge Speed</span>
          </div>
          <div>
            <span class="block text-2xl font-black text-slate-900 dark:text-white font-mono">0ms</span>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">Hydration Lag</span>
          </div>
          <div>
            <span class="block text-2xl font-black text-slate-900 dark:text-white font-mono">{posts.length}+</span>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">Playbooks</span>
          </div>
        </div>
      </div>

      <!-- Live macOS Glass Terminal -->
      <div class="lg:col-span-5 w-full">
        <div class="rounded-2xl bg-[#090E1A] border border-slate-700 dark:border-emerald-500/30 shadow-[0_20px_50px_rgba(0,0,0,0.4),0_0_30px_rgba(16,185,129,0.12)] overflow-hidden backdrop-blur-xl">
          <div class="h-10 bg-slate-900 px-4 flex items-center justify-between border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-[11px] font-mono text-slate-400 flex items-center gap-1.5">
              <TerminalIcon class="w-3 h-3 text-emerald-400" /> devstackhub-edge.sh
            </span>
            <div class="w-10"></div>
          </div>

          <div class="p-6 font-mono text-xs text-slate-300 space-y-3">
            <p class="text-slate-500"># Deploying production infrastructure stack</p>
            <p class="text-emerald-400">$ terraform plan -out=production.tfplan</p>
            <div class="p-3 rounded-lg bg-black/50 border border-slate-800/80 text-[11px] text-slate-400 space-y-1">
              <p><span class="text-emerald-400">✓</span> AWS EKS Cluster (v1.30)</p>
              <p><span class="text-emerald-400">✓</span> Istio Ingress Gateway + mTLS</p>
              <p><span class="text-emerald-400">✓</span> Cloudflare Edge CDN Caching</p>
            </div>
            <p class="text-cyan-400">$ helm upgrade --install devstackhub ./k8s</p>
            <p class="text-slate-400">Status: <span class="text-emerald-400 font-bold animate-pulse">● LIVE ON EDGE (sub-30ms)</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Curated Architecture Track Cards -->
    <section class="mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 uppercase tracking-wider font-semibold">Specialized Tracks</span>
          <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Explore Architecture Domains</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Track 1: Cloud & DevOps -->
        <a href="/category/cloud-devops/" class="neon-card-hover group p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <Cloud class="w-5 h-5" />
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                {countCategory('devops')} GUIDES
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Cloud & DevOps</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">Kubernetes, Terraform, AWS, Docker containers, CI/CD automation.</p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-mono transition-colors">
            <span>View Track</span>
            <ChevronRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>

        <!-- Track 2: System Admin -->
        <a href="/category/system-admin/" class="neon-card-hover group p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <Server class="w-5 h-5" />
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                {countCategory('sysadmin')} GUIDES
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">System Admin</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">Linux kernel tuning, SSH hardening, systemd, networking protocols.</p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-mono transition-colors">
            <span>View Track</span>
            <ChevronRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>

        <!-- Track 3: Modern Web -->
        <a href="/category/web-dev/" class="neon-card-hover group p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <Code2 class="w-5 h-5" />
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                {countCategory('webdev')} GUIDES
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Modern Web</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">Jamstack, Astro, TypeScript, edge runtimes, API architectures.</p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-mono transition-colors">
            <span>View Track</span>
            <ChevronRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>

        <!-- Track 4: Guides & Tutorials -->
        <a href="/category/guides/" class="neon-card-hover group p-6 rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <BookOpen class="w-5 h-5" />
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                {countCategory('guides')} GUIDES
              </span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Guides & Tutorials</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">Hands-on walkthroughs, setup scripts, and quick reference playbooks.</p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-mono transition-colors">
            <span>View Track</span>
            <ChevronRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      </div>
    </section>

    <!-- Interactive Filtered Guide Feed -->
    <section id="guides" class="mt-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <span class="text-xs font-mono font-semibold tracking-wider text-emerald-600 dark:text-emerald-400 uppercase">Production Field Manuals</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Featured Architecture Playbooks</h2>
        </div>
        
        <!-- Filter Tabs -->
        <div id="filter-buttons" class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-xs font-mono overflow-x-auto max-w-full shadow-sm">
          <button data-filter="all" class="filter-btn active px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold transition-all whitespace-nowrap">All Tracks</button>
          <button data-filter="devops" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all whitespace-nowrap">Cloud & DevOps</button>
          <button data-filter="sysadmin" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all whitespace-nowrap">SysAdmin</button>
          <button data-filter="webdev" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all whitespace-nowrap">Web Dev</button>
          <button data-filter="guides" class="filter-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all whitespace-nowrap">Guides</button>
        </div>
      </div>

      <!-- Playbook Cards Grid with Active Cover Images and Strict 1-to-9 Ordering -->
      <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => {
          const coverImg = getImageUrl(post.data.coverImage);
          return (
            <article data-category={getCategoryKey(post.data.category)} class="guide-card neon-card-hover group/card rounded-2xl bg-white dark:bg-[#090E1A]/90 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/40 shadow-sm dark:shadow-none transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <div>
                {coverImg && (
                  <div class="w-full h-48 overflow-hidden bg-slate-100 dark:bg-slate-900 relative border-b border-slate-100 dark:border-slate-800/80">
                    <img 
                      src={coverImg} 
                      alt={post.data.title} 
                      loading="lazy"
                      class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-white/80 dark:from-[#090E1A] via-transparent to-transparent opacity-60"></div>
                  </div>
                )}

                <div class="p-6">
                  <!-- Badges matching Track Cards -->
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                      {post.data.category}
                    </span>
                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
                      {post.data.badge}
                    </span>
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover/card:text-emerald-600 dark:group-hover/card:text-emerald-400 transition-colors leading-snug">
                    <a href={`/${post.id}/`}>{post.data.title}</a>
                  </h3>

                  <p class="text-xs text-slate-600 dark:text-slate-400 mt-2.5 leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
              </div>

              <!-- Action Bar -->
              <div class="p-6 pt-0 mt-2">
                <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 font-mono">
                  <span class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400 text-[11px]">
                    <Clock class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" /> {post.data.readTime}
                  </span>
                  <a 
                    href={`/${post.id}/`} 
                    class="group/btn inline-flex items-center gap-1.5 font-bold text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 transition-all duration-300 transform hover:scale-110 origin-right"
                  >
                    <span>Read Guide</span> 
                    <ArrowUpRight class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform duration-200" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Weekly Architecture Dispatch Newsletter Card -->
    <section class="max-w-5xl mx-auto mt-24 neon-card-hover rounded-3xl bg-white dark:bg-[#090E1A]/95 border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none p-8 sm:p-14 text-center relative overflow-hidden transition-all duration-300">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-mono font-bold tracking-widest text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 uppercase mb-6 shadow-sm">
          <Radio class="w-3 h-3 text-emerald-600 dark:text-emerald-400 animate-pulse" />
          Weekly Architecture Telemetry
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-snug">
          Join 2,500+ Engineers Receiving Our <br class="hidden sm:inline" />
          <span class="text-emerald-600 dark:text-emerald-400">Weekly Dispatch</span>
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-4 leading-relaxed font-sans max-w-xl mx-auto">
          Zero marketing fluff. Strictly production-grade Kubernetes manifests, Linux kernel tuning scripts, and high-scale edge delivery post-mortems delivered every Thursday.
        </p>

        <form class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-lg mx-auto" onsubmit="event.preventDefault(); alert('Subscribed to Weekly Dispatch!');">
          <div class="relative w-full">
            <Mail class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-500" />
            <input 
              type="email" 
              required 
              placeholder="architect@domain.com" 
              class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 rounded-xl text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
            />
          </div>
          <button 
            type="submit" 
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-500 dark:bg-emerald-400 hover:bg-emerald-400 dark:hover:bg-emerald-300 text-slate-950 font-bold font-mono text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(52,211,153,0.3)] transition-all shrink-0 active:scale-95"
          >
            <span>Subscribe</span>
            <Send class="w-3.5 h-3.5" />
          </button>
        </form>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.guide-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
      });
      btn.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || filter === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style is:global>
  /* Neon Hover Boundary Effect */
  .neon-card-hover {
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
  }
  .neon-card-hover:hover {
