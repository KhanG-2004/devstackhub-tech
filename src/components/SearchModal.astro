---
// Fetch content collections or generate index
import { getCollection } from 'astro:content';
const posts = await getCollection('blog').catch(() => []);
const searchIndex = posts.map(post => ({
  title: post.data.title,
  description: post.data.description || '',
  slug: `/blog/${post.slug}/`
}));
---

<!-- Trigger Button (Drop this into your Header.astro) -->
<button 
  id="search-trigger-btn"
  type="button" 
  class="flex items-center gap-3 px-3 py-1.5 rounded-full border border-slate-300 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-900/50 hover:border-emerald-500/50 text-slate-500 dark:text-slate-400 text-xs font-mono transition-all"
  aria-label="Open Command Palette"
>
  <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
  <span>Command Palette</span>
  <kbd class="px-1.5 py-0.5 text-[10px] rounded bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700">⌘K</kbd>
</button>

<!-- Modal Backdrop & Dialog -->
<div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-sm p-4 sm:p-6 md:p-20 overflow-y-auto">
  <div class="max-w-xl mx-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0B131E] shadow-2xl overflow-hidden transition-all">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-slate-200 dark:border-slate-800">
      <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        id="search-input" 
        type="text" 
        placeholder="Search guides, architectures, pipelines..." 
        autocomplete="off"
        class="w-full bg-transparent text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none font-mono"
      />
      <button id="search-close-btn" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-white font-mono px-2 py-1 rounded">ESC</button>
    </div>

    <!-- Search Results Container -->
    <ul id="search-results" class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60 p-2 empty:hidden"></ul>

    <div id="search-empty" class="hidden p-8 text-center text-xs text-slate-500 dark:text-slate-400 font-mono">
      No blueprint or technical guide matches this query.
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex }}>
  const modal = document.getElementById('search-modal');
  const triggerBtn = document.getElementById('search-trigger-btn');
  const closeBtn = document.getElementById('search-close-btn');
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const emptyMessage = document.getElementById('search-empty');

  function openSearch() {
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => searchInput.focus(), 50);
  }

  function closeSearch() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
    renderResults([]);
  }

  // Keyboard shortcut listener: Cmd + K or Ctrl + K
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      modal.classList.contains('hidden') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeSearch();
    }
  });

  triggerBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  // Query filter
  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults([]);
      return;
    }

    const filtered = searchIndex.filter(item => 
      item.title.toLowerCase().includes(query) || 
      item.description.toLowerCase().includes(query)
    );

    renderResults(filtered);
  });

  function renderResults(items) {
    resultsContainer.innerHTML = '';
    if (items.length === 0 && searchInput.value.trim() !== '') {
      emptyMessage.classList.remove('hidden');
      return;
    }
    emptyMessage.classList.add('hidden');

    items.forEach(item => {
      const li = document.createElement('li');
      li.innerHTML = `
        <a href="${item.slug}" class="block p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors group">
          <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-emerald-500 dark:group-hover:text-emerald-400">
            ${item.title}
          </div>
          ${item.description ? `<p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5">${item.description}</p>` : ''}
        </a>
      `;
      resultsContainer.appendChild(li);
    });
  }
</script>