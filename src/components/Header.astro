---
import { getCollection } from 'astro:content';
import { Search, Sun, Moon, Terminal, LayoutGrid, X, ExternalLink, ShieldCheck, Sparkles, ArrowRight } from 'lucide-astro';

// Fetch all posts to populate client-side search index
const posts = await getCollection('blog').catch(() => []);
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description || '',
  slug: `/${post.id}/`,
  category: post.data.category || 'Tech'
}));
---

<!-- Fixed Floating Header Wrapper with Dynamic Viewport Shield -->
<header class="fixed top-0 left-0 right-0 z-[100] pointer-events-none">
  <!-- Top Viewport Fade: Smooth fade in both light & dark modes -->
  <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-slate-50/80 dark:from-[#060911]/90 to-transparent pointer-events-none transition-colors duration-300"></div>

  <!-- Centered Island -->
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-4 flex justify-center">
    <div class="pointer-events-auto w-full h-14 rounded-2xl bg-white/90 dark:bg-[#090D16]/95 backdrop-blur-2xl border border-slate-200/90 dark:border-emerald-500/30 shadow-[0_10px_30px_-5px_rgba(0,0,0,0.08),0_0_15px_-2px_rgba(16,185,129,0.08)] dark:shadow-[0_10px_35px_-5px_rgba(0,0,0,0.9),0_0_20px_-2px_rgba(16,185,129,0.2)] flex items-center justify-between px-5 transition-all duration-300 hover:border-emerald-500/40">
      
      <!-- Brand Logo (High Contrast in both modes) -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 p-[1px] shadow-[0_0_15px_rgba(16,185,129,0.3)]">
          <div class="w-full h-full bg-slate-900 rounded-[11px] flex items-center justify-center">
            <Terminal class="w-4 h-4 text-emerald-400 group-hover:rotate-6 transition-transform" />
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-black tracking-wider text-slate-900 dark:text-white font-mono flex items-center gap-1.5">
            DEVSTACK<span class="text-emerald-600 dark:text-emerald-400">HUB</span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-ping"></span>
          </span>
          <span class="text-[9px] font-mono tracking-widest text-slate-500 dark:text-slate-400 uppercase -mt-1">Architect Engine</span>
        </div>
      </a>

      <!-- Core Nav Links (Harmonized background) -->
      <nav class="hidden md:flex items-center gap-1 bg-slate-100/90 dark:bg-slate-900/80 p-1 rounded-xl border border-slate-200 dark:border-slate-800/80">
        <a href="/category/cloud-devops/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-white hover:bg-emerald-500/10 transition-all">
          Cloud & DevOps
        </a>
        <a href="/category/system-admin/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-white hover:bg-emerald-500/10 transition-all">
          System Admin
        </a>
        <a href="/category/web-dev/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-white hover:bg-emerald-500/10 transition-all">
          Modern Web
        </a>
        <a href="/category/guides/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-white hover:bg-emerald-500/10 transition-all">
          Guides
        </a>
        <a href="/about-us/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
          About
        </a>
      </nav>

      <!-- Action Controls -->
      <div class="flex items-center gap-2.5">
        <button id="search-trigger" aria-label="Open Command Palette" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-900/90 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-300/80 dark:border-slate-700/60 text-slate-600 dark:text-slate-400 text-xs transition-all cursor-pointer">
          <Search class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
          <span class="hidden sm:inline font-mono text-[11px] font-medium">Command Palette</span>
          <kbd class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-emerald-600 dark:text-emerald-400 font-semibold">⌘K</kbd>
        </button>

        <button id="theme-toggle" aria-label="Toggle Theme" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-900/90 text-slate-700 dark:text-slate-300 border border-slate-300/80 dark:border-slate-700/60 hover:border-emerald-500/40 transition-all cursor-pointer">
          <Sun class="w-4 h-4 hidden dark:block text-emerald-400" />
          <Moon class="w-4 h-4 block dark:hidden text-amber-600" />
        </button>

        <button id="drawer-toggle" aria-label="Open Command Hub" class="p-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 transition-all cursor-pointer">
          <LayoutGrid class="w-4 h-4" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Command Palette Modal Backdrop & Dialog -->
<div id="search-modal" class="fixed inset-0 z-[150] hidden items-start justify-center p-4 sm:p-6 md:pt-28 bg-black/70 backdrop-blur-sm">
  <div class="relative w-full max-w-2xl rounded-2xl bg-white dark:bg-[#070D18] border border-slate-200 dark:border-slate-800 shadow-[0_25px_60px_rgba(0,0,0,0.3)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.9)] overflow-hidden transition-all">
    
    <!-- Input Bar -->
    <div class="flex items-center gap-3 px-4 py-3.5 border-b border-slate-200 dark:border-slate-800/80 bg-slate-50/50 dark:bg-[#090E1A]">
      <Search class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
      <input 
        id="search-input" 
        type="text" 
        placeholder="Search guides, architectures, pipelines... (Type / to focus)" 
        autocomplete="off"
        class="w-full bg-transparent text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none font-mono"
      />
      <button id="search-close" class="px-2 py-1 text-[11px] font-mono rounded-lg bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
        ESC
      </button>
    </div>

    <!-- Search Results Dynamic List -->
    <ul id="search-results" class="max-h-[60vh] overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60 p-2"></ul>

    <!-- Empty State -->
    <div id="search-empty" class="hidden py-12 px-4 text-center">
      <p class="text-xs font-mono text-slate-500 dark:text-slate-400">No blueprints or deployment guides found matching that query.</p>
    </div>

    <!-- Palette Modal Footer -->
    <div class="px-4 py-2.5 bg-slate-50 dark:bg-[#050811] border-t border-slate-200 dark:border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-500">
      <span>Navigate with keyboard</span>
      <span class="flex items-center gap-2">
        <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[10px]">↑</kbd>
        <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[10px]">↓</kbd>
        to move
      </span>
    </div>
  </div>
</div>

<!-- Slide Drawer Backdrop -->
<div id="drawer-backdrop" class="fixed inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-md z-[110] opacity-0 pointer-events-none transition-opacity duration-300"></div>

<!-- Slide Drawer Panel -->
<aside id="drawer-panel" class="fixed top-0 right-0 z-[120] h-full w-full sm:w-[380px] bg-white dark:bg-[#070A12] backdrop-blur-2xl border-l border-slate-200 dark:border-emerald-500/20 shadow-[-15px_0_40px_rgba(0,0,0,0.15)] dark:shadow-[-25px_0_60px_rgba(0,0,0,0.95)] translate-x-full transition-transform duration-300 ease-luxury-spring p-7 flex flex-col justify-between overflow-y-auto">
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800/80">
      <div class="flex items-center gap-2">
        <Sparkles class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        <span class="text-xs font-mono font-bold tracking-wider uppercase text-emerald-600 dark:text-emerald-400">Architecture Command Rail</span>
      </div>
      <button id="drawer-close" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors">
        <X class="w-4 h-4" />
      </button>
    </div>

    <div class="my-6 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs text-emerald-700 dark:text-emerald-300">
        <ShieldCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        <span>System Status: <strong class="text-slate-900 dark:text-white font-mono">100% Edge Ready</strong></span>
      </div>
      <span class="text-[10px] font-mono bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-md font-bold">PROD</span>
    </div>

    <div class="space-y-3">
      <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Curated Technical Tracks</span>
      
      <a href="/category/cloud-devops/" class="group block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 hover:bg-emerald-500/10 border border-slate-200 dark:border-slate-800/80 hover:border-emerald-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Cloud & DevOps</span>
          <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500">TRACK</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Docker, Kubernetes, Terraform, AWS CI/CD pipelines.</p>
      </a>

      <a href="/category/system-admin/" class="group block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 hover:bg-emerald-500/10 border border-slate-200 dark:border-slate-800/80 hover:border-emerald-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">System Admin & Linux</span>
          <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500">TRACK</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Kernel tuning, Bash automations, server hardening & SSH.</p>
      </a>

      <a href="/category/web-dev/" class="group block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 hover:bg-emerald-500/10 border border-slate-200 dark:border-slate-800/80 hover:border-emerald-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Web Development</span>
          <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500">TRACK</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Jamstack, Astro, Tailwind, edge runtime integrations.</p>
      </a>

      <a href="/category/guides/" class="group block p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/50 hover:bg-emerald-500/10 border border-slate-200 dark:border-slate-800/80 hover:border-emerald-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Guides & Tutorials</span>
          <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500">TRACK</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Step-by-step developer walkthroughs and tooling setups.</p>
      </a>
    </div>

    <!-- Informational Navigation Links -->
    <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-800/80 flex flex-col gap-2">
      <a href="/write-for-us/" class="flex items-center justify-between text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 py-1.5">
        <span>Submit a Playbook / Write For Us</span>
        <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a href="/about-us/" class="flex items-center justify-between text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 py-1.5">
        <span>About devstackhub.tech</span>
        <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a href="/contact-us/" class="flex items-center justify-between text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 py-1.5">
        <span>Contact Us</span>
        <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
      </a>
    </div>
  </div>

  <!-- Footer Badges -->
  <div class="pt-5 border-t border-slate-200 dark:border-slate-800/80 flex flex-col gap-4">
    <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">Engineering Channels</span>
    
    <div class="grid grid-cols-3 gap-2">
      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center py-2 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-300/80 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/50 transition-all shadow-sm"
      >
        GitHub
      </a>

      <a 
        href="https://dev.to" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center py-2 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-300/80 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/50 transition-all shadow-sm"
      >
        Dev.to
      </a>

      <a 
        href="https://hashnode.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center py-2 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-300/80 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/50 transition-all shadow-sm"
      >
        Hashnode
      </a>
    </div>

    <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 dark:text-slate-500 pt-1">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        v2.4.0 • EDGE DEPLOYED
      </span>
      <span>ASTRO V5</span>
    </div>
  </div>
</aside>

<script is:inline define:vars={{ searchIndex }}>
  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Drawer Panel Logic
  const drawerToggle = document.getElementById('drawer-toggle');
  const drawerClose = document.getElementById('drawer-close');
  const drawerBackdrop = document.getElementById('drawer-backdrop');
  const drawerPanel = document.getElementById('drawer-panel');

  const openDrawer = () => {
    drawerPanel?.classList.remove('translate-x-full');
    drawerBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
  };

  const closeDrawer = () => {
    drawerPanel?.classList.add('translate-x-full');
    drawerBackdrop?.classList.add('opacity-0', 'pointer-events-none');
  };

  drawerToggle?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  drawerBackdrop?.addEventListener('click', closeDrawer);

  // Search Command Palette Modal Logic
  const searchModal = document.getElementById('search-modal');
  const searchTrigger = document.getElementById('search-trigger');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchEmpty = document.getElementById('search-empty');

  const openSearch = () => {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    setTimeout(() => searchInput?.focus(), 50);
    renderResults(searchIndex);
  };

  const closeSearch = () => {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
    document.body.style.overflow = '';
    if (searchInput) searchInput.value = '';
  };

  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  // Global Keyboard Shortcuts (Cmd+K / Ctrl+K & ESC)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      searchModal?.classList.contains('hidden') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  // Search Filtering
  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults(searchIndex);
      return;
    }

    const matched = searchIndex.filter((item) => 
      item.title.toLowerCase().includes(query) ||
      item.description.toLowerCase().includes(query) ||
      item.category.toLowerCase().includes(query)
    );

    renderResults(matched);
  });

  function renderResults(items) {
    if (!searchResults || !searchEmpty) return;
    searchResults.innerHTML = '';

    if (!items || items.length === 0) {
      searchEmpty.classList.remove('hidden');
      return;
    }

    searchEmpty.classList.add('hidden');

    items.forEach((item) => {
      const li = document.createElement('li');
      li.innerHTML = `
        <a href="${item.slug}" class="flex items-start justify-between p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors group">
          <div class="space-y-1 pr-4">
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono uppercase font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">${item.category}</span>
              <span class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">${item.title}</span>
            </div>
            ${item.description ? `<p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">${item.description}</p>` : ''}
          </div>
          <span class="text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mt-1">→</span>
        </a>
      `;
      searchResults.appendChild(li);
    });
  }
</script>