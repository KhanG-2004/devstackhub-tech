---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Clock, Calendar, ArrowLeft, BookOpen, Send, Mail, Radio, Github, X } from 'lucide-astro';

import authorAvatar from '../assets/avatar.png';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(new Date(post.data.pubDate));

const getImageUrl = (img?: string) => {
  if (!img) return null;
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  return `https://devstackhub.tech${img.startsWith('/') ? img : '/' + img}`;
};

const coverImg = getImageUrl(post.data.coverImage);
const canonicalUrl = `https://devstackhub.tech/${post.id}/`;

// Structured Data Schemas
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "image": coverImg ? [coverImg] : ["https://devstackhub.tech/icon.png"],
  "datePublished": new Date(post.data.pubDate).toISOString(),
  "dateModified": new Date(post.data.pubDate).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": post.data.author || "Farraz Ahmed",
    "url": "https://devstackhub.tech/about-us/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "DevStackHub",
    "url": "https://devstackhub.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://devstackhub.tech/icon.png"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://devstackhub.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": post.data.category || "Articles",
      "item": `https://devstackhub.tech/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout 
  title={`${post.data.seoTitle || post.data.title} — DevStackHub`}
  description={post.data.description}
>
  <!-- Scroll Reading Progress Indicator -->
  <div class="fixed top-0 left-0 right-0 h-[3px] bg-transparent z-[200] pointer-events-none">
    <div 
      id="reading-progress-bar" 
      class="h-full w-0 bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 shadow-[0_0_12px_rgba(16,185,129,0.7)] transition-[width] duration-75 ease-out"
    ></div>
  </div>

  <!-- Inject JSON-LD Rich Snippet Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-24">
    <!-- Breadcrumb Return -->
    <div class="mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Return to Knowledge Base
      </a>
    </div>

    <!-- Article Header -->
    <header class="max-w-4xl mx-auto text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 mb-6">
        <span>{post.data.category}</span>
        <span>•</span>
        <span>{post.data.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15] mb-8">
        {post.data.title}
      </h1>

      <!-- Byline Avatar with Full Hair Visible -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-slate-600 dark:text-slate-400 py-3 border-y border-slate-200 dark:border-slate-800/80">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full overflow-hidden border border-emerald-500/40 shrink-0 bg-slate-100 dark:bg-slate-900 relative">
            <Image 
              src={authorAvatar} 
              alt={post.data.author} 
              class="w-full h-full object-cover"
              style="transform: scale(1.3) translateY(2.5%); transform-origin: 50% 26%;"
            />
          </div>
          <span class="text-slate-900 dark:text-slate-200 font-semibold">{post.data.author}</span>
        </div>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">•</span>
        <span class="flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
          {formattedDate}
        </span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">•</span>
        <span class="flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
          {post.data.readTime}
        </span>
      </div>
    </header>

    <!-- Header Cover Image (Zero white margins/gaps) -->
    {coverImg && (
      <div class="max-w-4xl mx-auto mb-14 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-2xl bg-transparent flex">
        <img src={coverImg} alt={post.data.title} class="w-full h-auto max-h-[520px] object-cover block m-0 p-0" />
      </div>
    )}

    <!-- Main Content & Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 max-w-6xl mx-auto">
      <article class="lg:col-span-8 article-body text-slate-700 dark:text-slate-300" id="article-content">
        <Content />
      </article>

      <!-- Sidebar with TOC and Architecture Rail Box -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-28 space-y-6">
          
          <!-- Table of Contents -->
          <div class="p-6 rounded-2xl bg-white dark:bg-[#090E1A] border border-slate-200 dark:border-slate-800 shadow-sm dark:shadow-none" id="toc-container">
            <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-200 dark:border-slate-800 text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold uppercase tracking-wider">
              <BookOpen class="w-4 h-4" />
              Table of Contents
            </div>
            <nav class="space-y-2 text-xs font-mono max-h-[50vh] overflow-y-auto pr-2" id="toc-nav">
              {headings && headings.length > 0 ? (
                headings.map((h) => (
                  <a href={`#${h.slug}`} class={`block text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors leading-relaxed ${h.depth === 3 ? 'pl-4 text-slate-500' : 'font-semibold'}`}>
                    {h.text}
                  </a>
                ))
              ) : (
                <div class="text-slate-400 dark:text-slate-500 italic text-[11px]" id="toc-loading">Analyzing article headings...</div>
              )}
            </nav>
          </div>

          <!-- DevStackHub Architecture Rail Box -->
          <div class="p-6 rounded-2xl bg-white dark:bg-[#070D18] border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-lg">
            <h4 class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 tracking-wider mb-3">
              DevStackHub Architecture Rail
            </h4>
            <p class="text-xs font-mono text-slate-600 dark:text-slate-400 leading-relaxed">
              Verified against production edge deployment configs with automated zero-trust inspection.
            </p>
          </div>

        </div>
      </aside>
    </div>

    <!-- Author Card (Moved Above Newsletter) -->
    <div class="max-w-4xl mx-auto mt-20 p-6 sm:p-8 rounded-3xl neon-card-hover bg-white dark:bg-[#070D18] border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none flex flex-col sm:flex-row gap-6 items-start transition-all duration-300">
      
      <!-- Clickable Photo Container: Seamless Edge, Full Hair & Face Focus -->
      <div class="relative shrink-0 group/avatar cursor-pointer" id="avatar-trigger" title="Click to view photo">
        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-emerald-500 dark:border-emerald-400 shadow-md bg-slate-100 dark:bg-[#070D18] relative">
          <Image 
            src={authorAvatar} 
            alt="Farraz Ahmed" 
            class="w-full h-full object-cover transition-transform duration-300 group-hover/avatar:brightness-105"
            style="transform: scale(1.3) translateY(2.5%); transform-origin: 50% 26%;"
          />
        </div>
        <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 dark:bg-emerald-400 border-4 border-white dark:border-[#070D18] rounded-full"></div>
      </div>
      
      <div class="flex-1 flex flex-col justify-between w-full">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <h3 class="text-2xl font-black text-slate-900 dark:text-white leading-none">Farraz Ahmed</h3>
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 dark:border-emerald-400/30 bg-emerald-500/10 dark:bg-emerald-400/10 tracking-wide uppercase">
              Systems & Cloud Architect
            </span>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm leading-relaxed mt-2 font-sans">
            Computer Science engineer focused on distributed cloud runtimes, Linux kernel optimization, zero-trust network meshes, and edge-native architectures.
          </p>
        </div>
        
        <div class="flex flex-wrap items-center justify-between mt-6 pt-4 border-t border-slate-200 dark:border-slate-800/80 gap-4">
          <div class="flex items-center gap-2">
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 dark:bg-[#0E1526] hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              <Github class="w-4 h-4" />
            </a>
            <a href="https://dev.to" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-[#0E1526] hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              DEV.to
            </a>
            <a href="https://hashnode.com" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-[#0E1526] hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              Hashnode
            </a>
          </div>
          <div class="flex items-center gap-1.5 text-xs font-mono text-emerald-600 dark:text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
            Verified Lead Architect
          </div>
        </div>
      </div>
    </div>

    <!-- Weekly Architecture Dispatch Newsletter Card -->
    <section class="max-w-4xl mx-auto mt-12 neon-card-hover rounded-3xl bg-white dark:bg-[#090E1A]/95 border border-slate-200 dark:border-slate-800/80 p-8 sm:p-14 text-center relative overflow-hidden transition-all duration-300 shadow-sm dark:shadow-none">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-mono font-bold tracking-widest text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 uppercase mb-6 shadow-sm">
          <Radio class="w-3 h-3 text-emerald-600 dark:text-emerald-400 animate-pulse" />
          Weekly Architecture Telemetry
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-snug">
          Join 2,500+ Engineers Receiving Our <br class="hidden sm:inline" />
          <span class="text-emerald-600 dark:text-emerald-400">Weekly Dispatch</span>
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-4 leading-relaxed font-sans max-w-xl mx-auto">
          Zero marketing fluff. Strictly production-grade Kubernetes manifests, Linux kernel tuning scripts, and high-scale edge delivery post-mortems delivered every Thursday.
        </p>

        <form class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-lg mx-auto" onsubmit="event.preventDefault(); alert('Subscribed to Weekly Dispatch!');">
          <div class="relative w-full">
            <Mail class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-500" />
            <input 
              type="email" 
              required 
              placeholder="architect@domain.com" 
              class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-[#040810] border border-slate-300 dark:border-slate-800 rounded-xl text-xs font-mono text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
            />
          </div>
          <button 
            type="submit" 
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-500 dark:bg-emerald-400 hover:bg-emerald-400 dark:hover:bg-emerald-300 text-slate-950 font-bold font-mono text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(52,211,153,0.3)] transition-all shrink-0 active:scale-95"
          >
            <span>Subscribe</span>
            <Send class="w-3.5 h-3.5" />
          </button>
        </form>
      </div>
    </section>

  </main>

  <!-- Viewport-Restricted & Top-Clear Lightbox Modal -->
  <div 
    id="photo-modal" 
    class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-md hidden items-center justify-center pt-20 pb-12 px-4 sm:px-8"
  >
    <div class="relative flex flex-col items-center max-w-full">
      <button 
        id="close-modal" 
        class="absolute -top-11 right-0 p-1.5 text-slate-300 hover:text-emerald-400 bg-slate-900/90 rounded-full border border-slate-700 transition-colors shadow-lg"
        title="Close (Esc)"
      >
        <X class="w-5 h-5" />
      </button>

      <div class="rounded-2xl overflow-hidden border-2 border-emerald-500/50 shadow-[0_0_40px_rgba(16,185,129,0.3)] bg-[#090E1A]">
        <Image 
          src={authorAvatar} 
          alt="Farraz Ahmed" 
          class="max-w-[80vw] max-h-[58vh] w-auto h-auto object-contain block"
        />
      </div>
      <p class="text-xs font-mono text-slate-300 mt-3.5 tracking-wide">
        Farraz Ahmed — Systems & Cloud Architect
      </p>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  // Reading Progress Bar Tracker
  const progressBar = document.getElementById('reading-progress-bar');
  const contentEl = document.getElementById('article-content');

  function updateReadingProgress() {
    if (!progressBar || !contentEl) return;

    const totalHeight = contentEl.clientHeight;
    const contentTop = contentEl.offsetTop;
    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;

    const distance = scrollY - contentTop + (windowHeight / 2);
    const progress = Math.min(Math.max((distance / totalHeight) * 100, 0), 100);

    progressBar.style.width = `${progress}%`;
  }

  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', updateReadingProgress);
  updateReadingProgress();

  // Lightbox Modal Logic
  const trigger = document.getElementById('avatar-trigger');
  const modal = document.getElementById('photo-modal');
  const closeBtn = document.getElementById('close-modal');

  function openModal() {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });

  // Dynamic TOC Fallback Generator for HTML / WordPress Content
  const tocNav = document.getElementById('toc-nav');
  const articleContent = document.getElementById('article-content');
  const tocLoading = document.getElementById('toc-loading');

  if (tocNav && articleContent) {
    const existingLinks = tocNav.querySelectorAll('a');
    if (existingLinks.length === 0) {
      const headings = articleContent.querySelectorAll('h2, h3');
      if (headings.length > 0) {
        if (tocLoading) tocLoading.remove();
        headings.forEach((heading, index) => {
          if (!heading.id) {
            heading.id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `heading-${index}`;
          }
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent || '';
          link.className = `block text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors leading-relaxed ${heading.tagName === 'H3' ? 'pl-4 text-slate-500' : 'font-semibold'}`;
          tocNav.appendChild(link);
        });
      } else {
        if (tocLoading) tocLoading.textContent = 'General Architecture Overview';
      }
    }
  }

  // Deduplicate Cover Photo from WordPress HTML body if it matches post cover
  if (articleContent) {
    const firstImg = articleContent.querySelector('img');
    const headerCover = document.querySelector('header + div img') as HTMLImageElement;
    if (firstImg && headerCover && (firstImg.src === headerCover.src || firstImg.getAttribute('src')?.includes('cover'))) {
      const parentFigure = firstImg.closest('figure');
      if (parentFigure) {
        parentFigure.remove();
      } else {
        firstImg.remove();
      }
    }
  }

  // Transform Code Blocks into Professional Terminal Windows with Dynamic Language Title & Right-Aligned Copy Button
  if (articleContent) {
    const codeBlocks = articleContent.querySelectorAll('pre, .wp-block-code');
    codeBlocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains('terminal-window-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'terminal-window-wrapper my-8 rounded-2xl bg-[#030712] border border-slate-800 hover:border-emerald-500/50 shadow-[0_15px_40px_rgba(0,0,0,0.6)] overflow-hidden transition-all duration-300';

      // Header Bar
      const topBar = document.createElement('div');
      topBar.className = 'h-11 bg-[#090E1A] px-4 flex items-center justify-between border-b border-slate-800/80 relative';

      // Left Controls: Traffic lights
      const dots = document.createElement('div');
      dots.className = 'flex items-center gap-1.5 shrink-0';
      dots.innerHTML = '<span class="w-3 h-3 rounded-full bg-rose-500/80 shadow-sm"></span><span class="w-3 h-3 rounded-full bg-amber-500/80 shadow-sm"></span><span class="w-3 h-3 rounded-full bg-emerald-500/80 shadow-sm"></span>';

      // Detect Code Language for Center Title
      let detectedLang = 'CODE';
      const codeEl = pre.querySelector('code') || pre;
      const classList = Array.from(codeEl.classList).concat(Array.from(pre.classList));
      
      for (const cls of classList) {
        if (cls.startsWith('language-') || cls.startsWith('lang-')) {
          detectedLang = cls.replace('language-', '').replace('lang-', '').toUpperCase();
          break;
        }
      }

      if (detectedLang === 'CODE') {
        const textSample = pre.textContent || '';
        if (textSample.includes('npm ') || textSample.includes('docker ') || textSample.includes('kubectl ') || textSample.includes('git ')) {
          detectedLang = 'BASH';
        } else if (textSample.includes('version:') || textsampleContainsYaml(textSample)) {
          detectedLang = 'YAML';
        } else if (textSample.includes('const ') || textSample.includes('import ') || textSample.includes('function ')) {
          detectedLang = 'JAVASCRIPT';
        }
      }

      function textsampleContainsYaml(txt: string) {
        return txt.includes('services:') || txt.includes('ports:') || txt.includes('image:');
      }

      // Center Language Title
      const titleSpan = document.createElement('span');
      titleSpan.className = 'absolute left-1/2 -translate-x-1/2 text-xs font-mono font-bold tracking-widest text-slate-300 uppercase';
      titleSpan.textContent = detectedLang;

      // Right-most Copy Button
      const copyBtn = document.createElement('button');
      copyBtn.className = 'px-2.5 py-1 rounded-lg bg-slate-800/95 hover:bg-emerald-500/20 text-[11px] font-mono text-emerald-400 border border-slate-700/80 hover:border-emerald-500/40 transition-all flex items-center gap-1.5 shadow-sm shrink-0';
      copyBtn.innerHTML = '<span>Copy</span>';
      copyBtn.onclick = () => {
        const rawCode = codeEl.innerText || codeEl.textContent || '';
        navigator.clipboard.writeText(rawCode);
        copyBtn.innerHTML = '<span class="text-emerald-300 font-bold">Copied!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = '<span>Copy</span>';
        }, 2000);
      };

      topBar.appendChild(dots);
      topBar.appendChild(titleSpan);
      topBar.appendChild(copyBtn);

      const rawText = codeEl.innerText || codeEl.textContent || '';
      const lines = rawText.split('\n');
      
      if (lines.length > 1 && lines[lines.length - 1].trim() === '') {
        lines.pop();
      }

      const formattedContainer = document.createElement('div');
      formattedContainer.className = 'flex py-4 overflow-x-auto text-xs font-mono leading-relaxed text-slate-200';

      const lineNumbersCol = document.createElement('div');
      lineNumbersCol.className = 'select-none pr-4 pl-4 text-right text-slate-600 border-r border-slate-800/60 bg-[#060A12] flex flex-col shrink-0';

      const codeLinesCol = document.createElement('div');
      codeLinesCol.className = 'pl-4 pr-4 flex-1 overflow-x-auto whitespace-pre';

      lines.forEach((lineText, idx) => {
        const numSpan = document.createElement('span');
        numSpan.className = 'block';
        numSpan.textContent = String(idx + 1);
        lineNumbersCol.appendChild(numSpan);

        const lineSpan = document.createElement('span');
        lineSpan.className = 'block';
        lineSpan.textContent = lineText === '' ? ' ' : lineText;
        codeLinesCol.appendChild(lineSpan);
      });

      formattedContainer.appendChild(lineNumbersCol);
      formattedContainer.appendChild(codeLinesCol);

      pre.innerHTML = '';
      pre.className = 'm-0 p-0 bg-transparent border-0 overflow-hidden';
      pre.appendChild(formattedContainer);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(topBar);
      wrapper.appendChild(pre);
    });
  }
</script>

<style is:global>
  /* Neon Hover Boundary Effect */
  .neon-card-hover {
