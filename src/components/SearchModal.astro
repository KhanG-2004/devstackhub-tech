---
import { Search, X, ArrowRight, CornerDownLeft } from 'lucide-astro';
---

<!-- Modal Backdrop -->
<div 
  id="search-modal-backdrop" 
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-[150] opacity-0 pointer-events-none transition-opacity duration-200 flex items-start justify-center pt-20 sm:pt-28 px-4"
>
  <!-- Modal Dialog -->
  <div 
    id="search-modal-dialog" 
    class="w-full max-w-2xl bg-[#090D16] border border-emerald-500/30 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.95)] overflow-hidden scale-95 transition-all duration-200"
  >
    <!-- Search Bar Input -->
    <div class="relative flex items-center px-4 py-3.5 border-b border-slate-800">
      <Search class="w-5 h-5 text-emerald-400 shrink-0 mr-3" />
      <input 
        id="search-input" 
        type="text" 
        placeholder="Search guides, architecture, Kubernetes, DevOps..." 
        autocomplete="off" 
        class="w-full bg-transparent text-sm text-white placeholder-slate-500 focus:outline-none font-mono"
      />
      <button 
        id="search-close" 
        class="p-1 rounded-lg text-slate-500 hover:text-white hover:bg-slate-800/80 transition-colors shrink-0 ml-2"
        aria-label="Close search"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" class="max-h-80 overflow-y-auto p-3 space-y-1 divide-y divide-slate-800/40">
      <div id="search-empty" class="p-6 text-center text-xs font-mono text-slate-500">
        Type keywords to query architecture playbooks...
      </div>
    </div>

    <!-- Modal Footer Controls -->
    <div class="px-4 py-2.5 bg-slate-900/60 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-500">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">ESC</kbd> to close
        </span>
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 flex items-center gap-0.5"><CornerDownLeft class="w-2.5 h-2.5" /> Enter</kbd> to select
        </span>
      </div>
      <span class="text-emerald-400">DevStackHub Engine</span>
    </div>
  </div>
</div>

<script>
  let articles: any[] = [];
  let fetched = false;

  const modalBackdrop = document.getElementById('search-modal-backdrop');
  const modalDialog = document.getElementById('search-modal-dialog');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close');
  const searchResults = document.getElementById('search-results');
  const searchTrigger = document.getElementById('search-trigger');

  async function loadIndex() {
    if (fetched) return;
    try {
      const res = await fetch('/api/search.json');
      articles = await res.json();
      fetched = true;
    } catch (e) {
      console.error('Failed to load search index:', e);
    }
  }

  function openSearch() {
    loadIndex();
    modalBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
    modalDialog?.classList.remove('scale-95');
    modalDialog?.classList.add('scale-100');
    setTimeout(() => searchInput?.focus(), 50);
  }

  function closeSearch() {
    modalBackdrop?.classList.add('opacity-0', 'pointer-events-none');
    modalDialog?.classList.remove('scale-100');
    modalDialog?.classList.add('scale-95');
    if (searchInput) searchInput.value = '';
    renderResults([]);
  }

  function renderResults(items: any[]) {
    if (!searchResults) return;

    if (!searchInput?.value.trim()) {
      searchResults.innerHTML = `
        <div class="p-6 text-center text-xs font-mono text-slate-500">
          Type keywords to query architecture playbooks...
        </div>`;
      return;
    }

    if (items.length === 0) {
      searchResults.innerHTML = `
        <div class="p-6 text-center text-xs font-mono text-slate-500">
          No playbooks matched your query.
        </div>`;
      return;
    }

    searchResults.innerHTML = items.map((item, idx) => `
      <a 
        href="${item.url}" 
        class="search-item block p-3 rounded-xl hover:bg-emerald-500/10 border border-transparent hover:border-emerald-500/30 transition-all group ${idx === 0 ? 'bg-slate-900/40' : ''}"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              ${item.category}
            </span>
            <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">
              ${item.title}
            </h4>
          </div>
          <span class="text-xs font-mono text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
            Read <span class="text-sm">→</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1 line-clamp-1">${item.description}</p>
      </a>
    `).join('');
  }

  searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    if (!q) {
      renderResults([]);
      return;
    }

    const filtered = articles.filter((a: any) => 
      a.title.toLowerCase().includes(q) ||
      a.description.toLowerCase().includes(q) ||
      a.category.toLowerCase().includes(q)
    );

    renderResults(filtered);
  });

  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  modalBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalBackdrop) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      modalBackdrop?.classList.contains('opacity-0') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !modalBackdrop?.classList.contains('opacity-0')) {
      closeSearch();
    }
  });
</script>